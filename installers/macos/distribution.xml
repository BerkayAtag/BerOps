<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Automation BER Agent</title>
    <organization>io.github.berkayatag</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <readme file="readme.html" mime-type="text/html"/>
    <license file="license.txt"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="12.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="io.github.berkayatag.ber.agent.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="io.github.berkayatag.ber.agent.pkg" visible="false">
        <pkg-ref id="io.github.berkayatag.ber.agent.pkg"/>
    </choice>
    <pkg-ref id="io.github.berkayatag.ber.agent.pkg" version="__VERSION__" onConclusion="none">ber-agent-component.pkg</pkg-ref>
</installer-gui-script>
