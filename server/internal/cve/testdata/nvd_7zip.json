   "cve": {
    "id": "CVE-2026-14266",
    "sourceIdentifier": "zdi-disclosures@trendmicro.com",
    "published": "2026-07-29T18:16:50.720",
    "lastModified": "2026-08-07T20:48:32.290",
    "vulnStatus": "Analyzed",
    "cveTags": [],
    "descriptions": [
     {
      "lang": "en",
      "value": "7-Zip XZ Decompression Heap-based Buffer Overflow Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of 7-Zip. User interaction is required to exploit this vulnerability in that the target must visit a malicious page or open a malicious file.\n\nThe specific flaw exists within the processing of XZ chunked data. Crafted XZ-compressed data can trigger an overflow of a heap-based buffer. An attacker can leverage this vulnerability to execute code in the context of the current process. Was ZDI-CAN-30169."
     }
    ],
